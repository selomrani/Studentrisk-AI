# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored and must never be committed.

# UID of the host user. Keeps files created inside the containers writable on the host.
AIRFLOW_UID=1000

# Postgres / Airflow metadata database credentials.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_DB_NAME=airflow

# Generate with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=

# Initial Airflow UI admin account (created by the airflow-init service).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# Kaggle credentials for kagglehub. Public datasets (like this project's)
# download anonymously, so these are optional. Find them at
# https://www.kaggle.com/settings -> API -> Create New Token.
KAGGLE_USERNAME=
KAGGLE_KEY=
